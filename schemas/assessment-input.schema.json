{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment-input.schema.json",
  "title": "Doc Vault per-file standards assessment",
  "description": "Assessment binds one currently eligible file to exact current rule revisions. The runtime checks applicability, source and rule identity, evidence, and the declared-authority requirement for noncompliant. Not-assessed is a coverage state, not a submitted verdict.",
  "type": "object",
  "properties": {
    "path": { "type": "string", "minLength": 1 },
    "expected_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "rule_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "result": { "enum": ["complies", "diverges", "noncompliant", "unknown", "not-applicable"] },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "evidence.schema.json" } }
        },
        "required": ["rule_id", "rule_hash", "result", "rationale", "evidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["path", "expected_source_sha256", "assessments"],
  "additionalProperties": false
}
