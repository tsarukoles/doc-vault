{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-input.schema.json",
  "title": "Doc Vault evidence review",
  "description": "An agent review tied to a specific note revision and current source evidence. Supported never means human approval.",
  "type": "object",
  "properties": {
    "note_path": { "type": "string", "minLength": 1 },
    "expected_note_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verdict": { "enum": ["supported", "needs-revision", "unresolved"] },
    "reason": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "evidence.schema.json" } }
  },
  "required": ["note_path", "expected_note_sha256", "verdict", "reason", "evidence"],
  "additionalProperties": false
}
